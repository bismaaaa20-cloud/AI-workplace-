# Gemini API: selected models have a limited free tier.
GEMINI_API_KEY=

# Groq Free Plan. Suggested OpenAI open-weight model: openai/gpt-oss-120b
GROQ_API_KEY=

# Mistral Studio Free mode. Keep pay-as-you-go/prepaid top-ups disabled in the account.
MISTRAL_API_KEY=

# Cloudflare Workers Free. Only select models available on the free plan.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: only model IDs ending in :free. Do not add paid credits.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=

# This file is local only. Never commit real keys or tokens.
